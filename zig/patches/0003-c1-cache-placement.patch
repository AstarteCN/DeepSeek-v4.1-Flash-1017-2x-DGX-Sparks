From: TensorFold recipe <noreply@invalid>
Subject: [PATCH 3/3] dsv41 lanes: a resumed prompt moves its kept rows to a free extent instead of over other kept states (cache placement)

Rationale: a prompt that resumes from a kept state (prefix reuse) used to continue in place, so the rows past the
kept ones could be written over another conversation's, or a longer branch's, kept state and make it stale. Now,
when that would happen, the kept rows are moved to an extent clear of every live stream and every non-stale kept
state if one fits; otherwise the pass resumes in place as before. Placement only: no arithmetic changes. Adds
host unit tests in lanes.zig. Also (review fixes): a move is placed from the pool top (placeHigh), and placeKept returns ContextFull before marking any kept state stale when the live streams alone leave no room. Switch: TF_DS_CACHE_PLACEMENT=1 enables (read in Lanes.init on every rank); unset or anything else = OFF: placeKept and every placement path are the pinned ones (all of the above is behind the one switch).

Written for this recipe; no code copied from other projects.
---
diff --git a/zig/src/families/dsv41/lanes.zig b/zig/src/families/dsv41/lanes.zig
index c55995d..41f64de 100644
--- a/zig/src/families/dsv41/lanes.zig
+++ b/zig/src/families/dsv41/lanes.zig
@@ -152,6 +152,61 @@ fn markEnds(marks: []const u32, at: usize) bool {
     return false;
 }
 
+/// TF_DS_CACHE_PLACEMENT (Lanes.init reads it on every rank; off unless "1"): a resume whose rows past the kept ones would
+/// go over another kept state moves the kept rows to a free extent when one fits (the keptOver branch in Lanes.begin).
+pub var cache_placement = false;
+
+/// placeKept's body over a table. With `refuse` (TF_DS_CACHE_PLACEMENT=1) and no room around the live streams alone,
+/// ContextFull comes back before any kept state goes stale (the request waits, every kept state still restores); without
+/// it the oldest states go stale until the extent fits or none is left, as the pin does.
+fn placeKeptIn(gpa: std.mem.Allocator, snaps: []const *Snap, live: []const [2]usize, size: usize, cap: usize, refuse: bool) !usize {
+    if (refuse and place(live, size, cap) == null) return error.ContextFull;
+    var used: std.ArrayList([2]usize) = .empty;
+    defer used.deinit(gpa);
+    while (true) {
+        used.clearRetainingCapacity();
+        try used.appendSlice(gpa, live);
+        for (snaps) |sn| if (!sn.stale) try used.append(gpa, .{ sn.base, sn.base + sn.at });
+        if (place(used.items, size, cap)) |b| return b;
+        const oldest = for (snaps) |sn| {
+            if (!sn.stale) break sn;
+        } else return error.ContextFull;
+        oldest.stale = true;
+    }
+}
+
+/// Whether a kept state other than `except`, not stale, has rows in [lo, hi) (the ones staleOver would make stale).
+fn keptOver(snaps: []const *Snap, lo: usize, hi: usize, except: *Snap) bool {
+    for (snaps) |sn| if (sn != except and !sn.stale and sn.base < hi and lo < sn.base + sn.at) return true;
+    return false;
+}
+
+/// The last extent of `size` positions clear of the live streams and of every kept state not stale (none goes
+/// stale), taken from the pool's top so the moved stream leaves the low end whole for placeKept's first fit (a move
+/// at the first gap splits the room a later prompt needs while the moved stream runs); null when none fits.
+fn placeFree(gpa: std.mem.Allocator, live: []const [2]usize, snaps: []const *Snap, size: usize, cap: usize) !?usize {
+    var used: std.ArrayList([2]usize) = .empty;
+    defer used.deinit(gpa);
+    try used.appendSlice(gpa, live);
+    for (snaps) |sn| if (!sn.stale) try used.append(gpa, .{ sn.base, sn.base + sn.at });
+    return placeHigh(used.items, size, cap);
+}
+
+/// The last chunk-aligned extent of `size` (chunk-aligned) positions in [0, cap) that overlaps none of `used`.
+pub fn placeHigh(used: []const [2]usize, size: usize, cap: usize) ?usize {
+    if (size > cap) return null;
+    var base = (cap - size) / model.chunk_rows * model.chunk_rows;
+    while (true) {
+        var clash: ?usize = null; // the lowest start of a used extent the candidate meets: the next one ends there
+        for (used) |u| {
+            if (base < u[1] and u[0] < base + size) clash = @min(clash orelse u[0], u[0]);
+        }
+        const lo = clash orelse return base;
+        if (lo < size) return null;
+        base = (lo - size) / model.chunk_rows * model.chunk_rows;
+    }
+}
+
 pub fn place(used: []const [2]usize, size: usize, cap: usize) ?usize {
     var base: usize = 0;
     while (base + size <= cap) {
@@ -245,6 +300,7 @@ pub const Lanes = struct {
 
     pub fn init(gpa: std.mem.Allocator, m: *Model) Lanes {
         var ln: Lanes = .{ .gpa = gpa, .m = m, .peer = if (m.world > 1) m.peer() else null };
+        cache_placement = if (std.c.getenv("TF_DS_CACHE_PLACEMENT")) |v| std.mem.eql(u8, std.mem.span(v), "1") else false; // every rank alike
         // the round costs by rows: ROUND_MS[min(rows, len) - 1] (the served table, or TF_DS_ROUND_MS)
         const t = m.round_ms;
         for (&ln.wc, 0..) |*c, i| c.* = .{ .width = @intCast(i + 1), .ms = t[@min(i, t.len - 1)] };
@@ -369,15 +425,23 @@ pub const Lanes = struct {
         s.cached = 0;
         var kept: ?*Snap = null;
         var moved = false;
+        var free_at: ?usize = null; // an extent the kept rows move to with no kept state going stale
         if (s.reuse.saved) |p| {
             const sn: *Snap = @ptrCast(@alignCast(p));
             // (a kept state knows no images: a prompt with them runs whole and keeps nothing)
             if (s.images.len == 0 and self.usable(sn, len)) {
                 kept = sn;
                 moved = sn.base + size > m.pool_cap or clashes(taken[0..nt], sn.base, sn.base + size);
+                // in place, the rows past the kept ones would go over other kept states (another conversation's, or
+                // a longer branch's): the kept rows move to an extent clear of every live stream and kept state when
+                // one fits, else the pass resumes in place as before
+                if (cache_placement and !moved and keptOver(self.snaps.items, sn.base + sn.at, sn.base + size, sn)) {
+                    free_at = try placeFree(gpa, taken[0..nt], self.snaps.items, size, m.pool_cap);
+                    moved = free_at != null;
+                }
             } else s.reuse_failed = true;
         }
-        const base = if (kept != null and !moved) kept.?.base else try self.placeKept(taken[0..nt], size);
+        const base = if (kept != null and !moved) kept.?.base else if (free_at) |b| b else try self.placeKept(taken[0..nt], size);
         if (kept) |sn| if (moved and sn.stale) { // the placement needed the kept rows' room: the prompt runs from 0
             kept = null;
             s.reuse_failed = true;
@@ -677,19 +741,7 @@ pub const Lanes = struct {
     /// The first extent that fits around the live streams and the kept states; the oldest kept states go stale
     /// until it does.
     fn placeKept(self: *Lanes, live: []const [2]usize, size: usize) !usize {
-        const gpa = self.gpa;
-        var used: std.ArrayList([2]usize) = .empty;
-        defer used.deinit(gpa);
-        while (true) {
-            used.clearRetainingCapacity();
-            try used.appendSlice(gpa, live);
-            for (self.snaps.items) |sn| if (!sn.stale) try used.append(gpa, .{ sn.base, sn.base + sn.at });
-            if (place(used.items, size, self.m.pool_cap)) |b| return b;
-            const oldest = for (self.snaps.items) |sn| {
-                if (!sn.stale) break sn;
-            } else return error.ContextFull;
-            oldest.stale = true;
-        }
+        return placeKeptIn(self.gpa, self.snaps.items, live, size, self.m.pool_cap, cache_placement);
     }
 
     /// Kept states with rows in [lo, hi) go stale (a stream writes there), `except` aside.
@@ -935,6 +987,82 @@ test "extents take the first chunk-aligned gap" {
     try std.testing.expectEqual(@as(?usize, null), place(&used, 4096, 10240));
 }
 
+test "a resume moves past another conversation's kept rows when an extent is free, else stays in place" {
+    const gpa = std.testing.allocator;
+    const c = model.chunk_rows;
+    // a's state [0, 2c) and b's [2c, 4c), both conversations idle; a's next turn takes 6c positions
+    var a: Snap = .{ .id = 1, .at = 2 * c, .base = 0, .buf = undefined };
+    var b: Snap = .{ .id = 2, .at = 2 * c, .base = 2 * c, .buf = undefined };
+    const snaps = [_]*Snap{ &a, &b };
+    try std.testing.expect(keptOver(&snaps, a.base + a.at, a.base + 6 * c, &a)); // in place it writes over b's rows
+    try std.testing.expect(!keptOver(&snaps, b.base + b.at, b.base + 6 * c, &b)); // b's own turn writes over none
+    try std.testing.expectEqual(@as(?usize, 10 * c), try placeFree(gpa, &.{}, &snaps, 6 * c, 16 * c)); // the top, past both
+    try std.testing.expectEqual(@as(?usize, 10 * c), try placeFree(gpa, &.{.{ 4 * c, 8 * c }}, &snaps, 6 * c, 16 * c)); // past a live stream
+    try std.testing.expectEqual(@as(?usize, null), try placeFree(gpa, &.{.{ 8 * c, 12 * c }}, &snaps, 6 * c, 16 * c)); // [4c, 8c) and [12c, 16c) too short
+    try std.testing.expectEqual(@as(?usize, null), try placeFree(gpa, &.{}, &snaps, 6 * c, 8 * c)); // none: in place, as before
+    b.stale = true;
+    try std.testing.expect(!keptOver(&snaps, a.base + a.at, a.base + 6 * c, &a)); // a stale state holds no rows
+    try std.testing.expectEqual(@as(?usize, 2 * c), try placeFree(gpa, &.{}, &snaps, 6 * c, 8 * c));
+}
+
+test "the cache placement branch is off unless TF_DS_CACHE_PLACEMENT=1 (the pinned resume path)" {
+    try std.testing.expect(!cache_placement);
+}
+
+test "a move takes the pool's top: a prompt placed while the moved stream runs still finds the low end whole" {
+    const gpa = std.testing.allocator;
+    const c = model.chunk_rows;
+    // a's state [0, 2c), b's [2c, 4c) in a 12c pool; a's next turn takes 4c and in place would write over b's rows
+    var a: Snap = .{ .id = 1, .at = 2 * c, .base = 0, .buf = undefined };
+    var b: Snap = .{ .id = 2, .at = 2 * c, .base = 2 * c, .buf = undefined };
+    const snaps = [_]*Snap{ &a, &b };
+    try std.testing.expectEqual(@as(?usize, 8 * c), try placeFree(gpa, &.{}, &snaps, 4 * c, 12 * c));
+    // a's turn now runs at [8c, 12c). A 7c prompt arrives: with the switch on it takes [0, 7c) after both kept states go
+    // stale (they must, the room is there); a first-fit move to [4c, 8c) would have left none
+    const live = [_][2]usize{.{ 8 * c, 12 * c }};
+    try std.testing.expectEqual(@as(?usize, 0), try placeKeptIn(gpa, &snaps, &live, 7 * c, 12 * c, true));
+    try std.testing.expect(a.stale and b.stale);
+    a.stale = false;
+    b.stale = false;
+    // the fragmented pool: the live stream at [4c, 8c) leaves 4c and 4c: no room for 7c however many go stale. On, the
+    // request is refused before any state goes stale; off, the pin's wipe happens first and then ContextFull
+    const frag = [_][2]usize{.{ 4 * c, 8 * c }};
+    var d: Snap = .{ .id = 3, .at = 2 * c, .base = 8 * c, .buf = undefined };
+    const snaps3 = [_]*Snap{ &a, &b, &d };
+    try std.testing.expectError(error.ContextFull, placeKeptIn(gpa, &snaps3, &frag, 7 * c, 12 * c, true));
+    try std.testing.expect(!a.stale and !b.stale and !d.stale);
+    try std.testing.expectError(error.ContextFull, placeKeptIn(gpa, &snaps3, &frag, 7 * c, 12 * c, false));
+    try std.testing.expect(a.stale and b.stale and d.stale); // the pinned behaviour
+}
+
+test "placeKeptIn without the switch is the pinned placeKept; with room both agree" {
+    const gpa = std.testing.allocator;
+    const c = model.chunk_rows;
+    var a: Snap = .{ .id = 1, .at = 2 * c, .base = 0, .buf = undefined };
+    var b: Snap = .{ .id = 2, .at = 2 * c, .base = 2 * c, .buf = undefined };
+    const snaps = [_]*Snap{ &a, &b };
+    // a gap exists: the first fit, nothing goes stale, switch or not
+    try std.testing.expectEqual(@as(usize, 4 * c), try placeKeptIn(gpa, &snaps, &.{}, 4 * c, 12 * c, false));
+    try std.testing.expectEqual(@as(usize, 4 * c), try placeKeptIn(gpa, &snaps, &.{}, 4 * c, 12 * c, true));
+    try std.testing.expect(!a.stale and !b.stale);
+    // no gap but the live streams leave room: the oldest goes stale first, the same either way
+    try std.testing.expectEqual(@as(usize, 0), try placeKeptIn(gpa, &snaps, &.{}, 12 * c, 12 * c, false));
+    try std.testing.expect(a.stale and b.stale);
+    a.stale = false;
+    b.stale = false;
+    try std.testing.expectEqual(@as(usize, 0), try placeKeptIn(gpa, &snaps, &.{}, 12 * c, 12 * c, true));
+    try std.testing.expect(a.stale and b.stale);
+}
+
+test "the last chunk-aligned gap" {
+    const used = [_][2]usize{ .{ 0, 4096 }, .{ 6144, 8192 } };
+    try std.testing.expectEqual(@as(?usize, (1 << 20) - 2048), placeHigh(&used, 2048, 1 << 20));
+    try std.testing.expectEqual(@as(?usize, 4096), placeHigh(&used, 2048, 8192));
+    try std.testing.expectEqual(@as(?usize, 0), placeHigh(&.{}, 2048, 2048));
+    try std.testing.expectEqual(@as(?usize, null), placeHigh(&used, 4096, 10240));
+    try std.testing.expectEqual(@as(?usize, null), placeHigh(&.{}, 4096, 2048));
+}
