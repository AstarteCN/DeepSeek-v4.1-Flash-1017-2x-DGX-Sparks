+    /// A prompt pass stands between two chunks (Stream.yield): up to yield_rounds decode rounds for the streams already live, their
+    /// tokens delivered, the cancels of every job but the pass's own taken. Runs on the engine thread inside the pass; the
+    /// backend has joined its read-ahead and cleared its fill state around the call. A round that fails ends the other streams
+    /// as a failed round does (the pass's own stream is left to the pass: its next chunk fails the same way).
+    fn yieldRound(ctx: *anyopaque) void {
+        const h: *LaneHost = @ptrCast(@alignCast(ctx));
+        const cur = h.prefilling orelse return;
+        var round: u32 = 0;
+        while (round < h.yield_rounds) : (round += 1) {
+            h.takeCancelsExcept(cur.id);
+            if (h.core.activeCount() == 0) return;
+            h.core.step() catch |e| {
+                h.failAllExcept(cur, @errorName(e));
+                return;
+            };
+            var i: usize = 0;
+            while (i < h.admitted.items.len) {
+                const job = h.admitted.items[i];
+                if (job == cur) {
+                    i += 1;
+                    continue;
+                }
+                if (h.deliver(job)) {
+                    h.lock();
+                    _ = h.admitted.orderedRemove(i);
+                    h.unlock();
+                } else i += 1;
+            }
+            h.noteLive();
+        }
+    }
+
+    /// failAll for the streams other than the one whose prompt pass is running.
+    fn failAllExcept(h: *LaneHost, skip: *Job, message: []const u8) void {
+        h.lock();
+        var jobs: std.ArrayList(*Job) = .empty;
+        defer jobs.deinit(h.gpa);
+        var i: usize = 0;
+        while (i < h.admitted.items.len) {
+            const job = h.admitted.items[i];
+            if (job == skip) {
+                i += 1;
+                continue;
+            }
+            jobs.append(h.gpa, job) catch {};
+            _ = h.admitted.orderedRemove(i);
+        }
+        h.unlock();
+        for (jobs.items) |job| {
+            if (!job.stream.finished) h.core.discard(&job.stream);
+            h.finish(job, .failed, message);
+        }
+    }
+
     /// Whether an admitted stream decodes within finish_left tokens of its max_tokens (the lock held).
