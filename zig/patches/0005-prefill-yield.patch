diff --git a/zig/src/core/lane_host_test.zig b/zig/src/core/lane_host_test.zig
index 061a871..2c390fb 100644
--- a/zig/src/core/lane_host_test.zig
+++ b/zig/src/core/lane_host_test.zig
@@ -213,3 +213,111 @@ test "after a long prompt pass, a stream near its max_tokens ends before the nex
     // the first request (64 tokens: within finish_left) ended before the second's first token
     try std.testing.expect(seq.a_done.? < seq.b_first.?);
 }
+
+/// Runs request 1 (a long decode), then request 2 (a prompt pass of five chunks), and returns how many tokens request 1 got
+/// during the second pass's chunks (the count at its last chunk minus at its first) and whether request 1's cancel, sent in the
+/// pass's middle, was answered before the pass ended.
+fn yieldRun(yield_rounds: u32, cancel_in_pass: bool, answered_in_pass: *bool) !u32 {
+    const gpa = std.testing.allocator;
+    var cfg = try lanes.Config.init(gpa, .{ .exact_width = 8, .gpu_tokens = true, .hidden_rows = true }, 8, 7);
+    defer cfg.deinit(gpa);
+    const Seq = struct {
+        mutex: std.Io.Mutex = .init,
+        a_tokens: u32 = 0,
+        a_done: bool = false,
+        b_done: bool = false,
+        calls: u32 = 0,
+        first: ?u32 = null,
+        last: u32 = 0,
+        a_done_in_pass: bool = false,
+        in_pass: bool = false,
+        host: *LaneHost = undefined,
+        fn event(ctx: *anyopaque, id: Id, e: *const Event) void {
+            const q: *@This() = @ptrCast(@alignCast(ctx));
+            q.mutex.lockUncancelable(std.testing.io);
+            defer q.mutex.unlock(std.testing.io);
+            switch (e.*) {
+                .tokens => |t| if (id == 1) {
+                    q.a_tokens += @intCast(t.len);
+                },
+                .prefilled => if (id == 2) {
+                    q.in_pass = false;
+                },
+                .finished => if (id == 1) {
+                    q.a_done = true;
+                    if (q.in_pass) q.a_done_in_pass = true;
+                } else {
+                    q.b_done = true;
+                },
+            }
+        }
+        fn hook(ctx: *anyopaque, _: *lanes.stream.Stream, chunk: usize) void {
+            const q: *@This() = @ptrCast(@alignCast(ctx));
+            std.Io.sleep(std.testing.io, .fromMilliseconds(30), .awake) catch {};
+            q.mutex.lockUncancelable(std.testing.io);
+            q.calls += 1;
+            // calls 1-5 are request 1's own pass, 6-10 request 2's
+            if (q.calls > 5) {
+                q.in_pass = true;
+                if (q.first == null) q.first = q.a_tokens;
+                q.last = q.a_tokens;
+            }
+            q.mutex.unlock(std.testing.io);
+            if (q.calls == 8 and chunk == 2) q.host.engine().cancel(1);
+        }
+    };
+    var seq: Seq = .{};
+    var target: lanes.fake.Fake = .{ .gpa = gpa, .prefill_chunks = 5, .prefill_hook = Seq.hook, .prefill_hook_ctx = &seq };
+    defer target.deinit();
+    var clock: lanes.fake.FixedClock = .{};
+    var core = lanes.Engine.init(gpa, &cfg, target.backend(), clock.clock());
+    defer core.deinit();
+    var host = LaneHost.init(gpa, std.testing.io, &core, .{ .lanes = 2 });
+    host.yield_rounds = yield_rounds;
+    seq.host = &host;
+    try host.start();
+    defer host.stop();
+    const prompt = [_]u32{ 2, 7, 1, 8 };
+    const e = host.engine();
+    try e.submit(1, &.{ .prompt = &prompt, .max_tokens = 100000 }, .{ .ctx = &seq, .event = Seq.event });
+    // request 1 decodes alone for a moment
+    for (0..2000) |_| {
+        seq.mutex.lockUncancelable(std.testing.io);
+        const n = seq.a_tokens;
+        seq.mutex.unlock(std.testing.io);
+        if (n > 20) break;
+        std.Io.sleep(std.testing.io, .fromMilliseconds(1), .awake) catch {};
+    }
+    try e.submit(2, &.{ .prompt = &prompt, .max_tokens = 4 }, .{ .ctx = &seq, .event = Seq.event });
+    for (0..10000) |_| {
+        seq.mutex.lockUncancelable(std.testing.io);
+        const done = seq.b_done;
+        seq.mutex.unlock(std.testing.io);
+        if (done) break;
+        std.Io.sleep(std.testing.io, .fromMilliseconds(1), .awake) catch {};
+    }
+    if (!cancel_in_pass) e.cancel(1);
+    for (0..2000) |_| {
+        seq.mutex.lockUncancelable(std.testing.io);
+        const done = seq.a_done;
+        seq.mutex.unlock(std.testing.io);
+        if (done) break;
+        std.Io.sleep(std.testing.io, .fromMilliseconds(1), .awake) catch {};
+    }
+    try std.testing.expect(seq.b_done and seq.a_done);
+    answered_in_pass.* = seq.a_done_in_pass;
+    return seq.last - (seq.first orelse 0);
+}
+
+test "TF_DS_PREFILL_YIELD: a live stream decodes between the chunks of another request's prompt pass, and its cancel is answered there" {
+    var off_answered = false;
+    var on_answered = false;
+    const off = try yieldRun(0, true, &off_answered);
+    const on = try yieldRun(3, true, &on_answered);
+    // off: nothing decodes during the pass, and request 1's cancel waits for it to end
+    try std.testing.expectEqual(@as(u32, 0), off);
+    try std.testing.expect(!off_answered);
+    // on: rounds ran between the chunks, and the cancel sent in the middle of the pass ended request 1 inside it
+    try std.testing.expect(on > 0);
+    try std.testing.expect(on_answered);
+}
