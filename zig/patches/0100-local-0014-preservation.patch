+
+// A concat result is immutable, but its unused tail can be appended to without
+// changing any previously published prefix slice. Branches and growth always
+// allocate another buffer; the render arena keeps old aliases alive.
+const list_acc_min = 128;
+
+fn isListAcc(c: *const Ctx, items: []const Value) bool {
+    return items.len > 0 and items.ptr == c.list_acc.items.ptr and items.len == c.list_acc.items.len;
+}
+
+fn joinList(c: *Ctx, l: []const Value, r: []const Value) Error![]const Value {
+    const a = c.rt.a;
+    if (l.len < list_acc_min and !isListAcc(c, l)) return std.mem.concat(a, Value, &.{ l, r });
+    const needed = std.math.add(usize, l.len, r.len) catch return error.OutOfMemory;
+    const fresh = !isListAcc(c, l);
+    if (fresh or needed > c.list_acc.capacity) {
+        const capacity = if (fresh) needed else std.math.mul(usize, needed, 2) catch needed;
+        var grown: std.ArrayList(Value) = try .initCapacity(a, capacity);
+        grown.appendSliceAssumeCapacity(l);
+        c.list_acc = grown;
+    }
+    c.list_acc.appendSliceAssumeCapacity(r);
+    return c.list_acc.items;
 }
 
