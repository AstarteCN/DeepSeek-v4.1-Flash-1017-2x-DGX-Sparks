+//! Opt-in HTTP connection arena capacity diagnostics. Never logs request contents or identities.
+//! queryCapacity reports reserved capacity, not live/used bytes; read only on the owning connection thread.
+const std = @import("std");
+
+const Connection = struct {
+    arena: *std.heap.ArenaAllocator,
+    id: u64,
+    request_attempt: u64 = 0,
+    prepare_attempt: u64 = 0,
+};
+
+var next_connection_id: std.atomic.Value(u64) = .init(1);
+threadlocal var connection: ?Connection = null;
+
+pub fn enabled() bool {
+    return if (std.c.getenv("TF_DS_MEMORY_DIAG")) |v| std.mem.eql(u8, std.mem.span(v), "1") else false;
+}
+
+pub fn beginConnection(arena: *std.heap.ArenaAllocator) void {
+    if (!enabled()) return;
+    connection = .{ .arena = arena, .id = next_connection_id.fetchAdd(1, .monotonic) };
+    note("connection_open");
+}
+
+/// Runs before the caller's existing arena.deinit; does not free/reset anything.
+pub fn endConnection() void {
+    note("connection_close_before_deinit");
+    connection = null;
+}
+
+/// A read attempt includes handled/closed requests; the number is not an engine request ID.
+pub fn beforeReset() void {
+    if (connection) |*c| c.request_attempt +%= 1;
+    note("before_retain_reset");
+}
+
+pub fn afterReset(ok: bool) void {
+    const c = connection orelse return;
+    std.debug.print("[tf-memory-diag] connection={d} request_attempt={d} phase=after_retain_reset capacity_bytes={d} reset_ok={any}\n", .{
+        c.id, c.request_attempt, c.arena.queryCapacity(), ok,
+    });
+}
+
+pub fn note(comptime phase: []const u8) void {
+    const c = connection orelse return;
+    std.debug.print("[tf-memory-diag] connection={d} request_attempt={d} phase={s} capacity_bytes={d}\n", .{
+        c.id, c.request_attempt, phase, c.arena.queryCapacity(),
+    });
+}
+
+pub const Preparation = struct {
+    connection_id: u64,
+    request_attempt: u64,
+    prepare_attempt: u64,
+    kind: []const u8,
+    arena: ?*std.heap.ArenaAllocator,
+    capacity_before: usize,
+};
+
+/// The allocator check avoids attributing a scratch allocator's work to the connection arena.
+/// No HTTP binding (for example a background thread) means no connection-scoped sample.
+pub fn beginPrepare(a: std.mem.Allocator, comptime kind: []const u8) ?Preparation {
+    if (connection) |*c| {
+        c.prepare_attempt +%= 1;
+        const owner = c.arena.allocator();
+        const same_arena = a.ptr == owner.ptr and a.vtable == owner.vtable;
+        const p: Preparation = .{
+            .connection_id = c.id,
+            .request_attempt = c.request_attempt,
+            .prepare_attempt = c.prepare_attempt,
+            .kind = kind,
+            .arena = if (same_arena) c.arena else null,
+            .capacity_before = if (same_arena) c.arena.queryCapacity() else 0,
+        };
+        std.debug.print("[tf-memory-diag] connection={d} request_attempt={d} prepare_attempt={d} kind={s} phase=prepare_before capacity_known={any} capacity_bytes={d}\n", .{
+            p.connection_id, p.request_attempt, p.prepare_attempt, p.kind, p.arena != null, p.capacity_before,
+        });
+        return p;
+    }
+    return null;
+}
+
+pub fn endPrepare(preparation: ?Preparation, ok: bool, tokens: ?usize) void {
+    const p = preparation orelse return;
+    const capacity_after = if (p.arena) |a| a.queryCapacity() else 0;
+    std.debug.print("[tf-memory-diag] connection={d} request_attempt={d} prepare_attempt={d} kind={s} phase=prepare_after ok={any} capacity_known={any} capacity_before_bytes={d} capacity_after_bytes={d} tokens_known={any} tokens={d}\n", .{
+        p.connection_id, p.request_attempt, p.prepare_attempt, p.kind, ok, p.arena != null,
+        p.capacity_before, capacity_after, tokens != null, tokens orelse 0,
+    });
+}
