+    try std.testing.expectEqual(@as(u64, 13), m.cache_accounted_prompt);
+    try std.testing.expectEqual(@as(u64, 11), m.cached);
+    try std.testing.expect(m.cached <= m.cache_accounted_prompt and m.cache_accounted_prompt <= m.prompt);
+}
+
+test "cache registry epoch is initialized once" {
+    const io = std.testing.io;
+    var m: Metrics = .{ .gpa = std.testing.allocator };
+    m.noteAccounted(io, 0, 0, 0, 0, 0, 0, null, null, null, null, 0);
+    const epoch = m.counter_epoch_milliseconds;
+    try std.testing.expect(epoch > 0);
+    m.noteAccounted(io, 1, 0, 0, 0, 0, 0, null, null, null, null, 1);
+    try std.testing.expectEqual(epoch, m.counter_epoch_milliseconds);
+}
+
+test "concurrent finished requests credit one coherent cache split each" {
+    const io = std.testing.io;
+    var m: Metrics = .{ .gpa = std.testing.allocator, .counter_epoch_milliseconds = 1 };
+    const Work = struct {
+        metrics: *Metrics,
+        io: std.Io,
+        fn run(work: *@This()) void {
+            for (0..100) |_| work.metrics.noteAccounted(work.io, 10, 1, 0, 0, 0, 0, null, null, null, null, 6);
+        }
+    };
+    var work: Work = .{ .metrics = &m, .io = io };
+    var threads: [4]std.Thread = undefined;
+    var started: usize = 0;
+    defer for (threads[0..started]) |thread| thread.join();
+    for (&threads) |*thread| {
+        thread.* = try std.Thread.spawn(.{}, Work.run, .{&work});
+        started += 1;
+    }
+    for (0..100) |_| {
+        m.mutex.lockUncancelable(io);
+        const p = m.prompt;
+        const c = m.cached;
+        const a = m.cache_accounted_prompt;
+        m.mutex.unlock(io);
+        try std.testing.expect(c <= a and a == p);
+    }
+    for (threads) |thread| thread.join();
+    started = 0;
+    try std.testing.expectEqual(@as(u64, 4000), m.prompt);
+    try std.testing.expectEqual(@as(u64, 4000), m.cache_accounted_prompt);
+    try std.testing.expectEqual(@as(u64, 2400), m.cached);
+    try std.testing.expectEqual(@as(u64, 400), m.generation);
+}
