# Offline-reviewed candidate, not installed. Overlay onto a verified private node configuration.
# Do not source into the running stable service or reuse its image/container identity.
: "${VERIFIED_STABLE_MODEL_REVISION:?Verify the running0014 weight revision before sourcing this candidate}"
: "${VERIFIED_STABLE_ENGRAM_REVISION:?Verify the running0014 Engram revision before sourcing this candidate}"
[[ "$VERIFIED_STABLE_MODEL_REVISION" == 878f5689915bcb44d985125e9a8cd4b78874e546 ]] || { echo "Stable model revision differs from archived0014; stop and review, never fall back to upstream default" >&2; return 1; }
[[ "$VERIFIED_STABLE_ENGRAM_REVISION" == 1bae0e1088993b9b82de08f59de5be5a34e42170 ]] || { echo "Stable Engram revision differs; stop and review" >&2; return 1; }
MODEL_REVISION="$VERIFIED_STABLE_MODEL_REVISION"
ENGRAM_REVISION="$VERIFIED_STABLE_ENGRAM_REVISION"
CONTEXT=1048576
PARALLEL=4
POOL=5218304
KV_SHARD=1
ROUND_ROWS=16
KV_SHARD_DECODE=fetch
KV_SHARD_CARRY=1
KV_SHARD_TWINS=1
KV_SHARD_CHECK=1024
TENSORFOLD_PREPARE_FLOOR_GIB=3
MEMGUARD_GIB=2.5
MEMGUARD_HOLD_S=4
MEMGUARD_HARD_GIB=1
# First A/B phase: no persistence and no automatic restart to hide evidence.
SPILL_GIB=0
PAIR_RESTART=0
TF_DS_MEMORY_DIAG=0
HF_HUB_OFFLINE=1
# These guards deliberately require a live-stable verification before any startup.
# The source default45ee... is never substituted for the archived stable878f... by this overlay.
# Later spill phase only, after local disk/ownership/budget review on both idle nodes:
# SPILL_GIB=64
# SPILL_FLOOR_GIB=50
# SPILL_STAGING_MIB=128
# SPILL_TURNS=4
# SPILL_FLUSH_MS=60000
# SPILL_DIR and WORKER_SPILL_DIR must be explicitly verified private local folders.
